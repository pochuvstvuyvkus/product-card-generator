# Скопируйте в .env и впишите ключ. Файл .env в git не попадает.
ANTHROPIC_API_KEY=

# Необязательные настройки (значения по умолчанию указаны справа)
# LLM_MODEL=claude-sonnet-5-5
# LLM_EFFORT=medium            # low | medium | high
# LLM_TIMEOUT=120              # секунд на один запрос
# LLM_MAX_RETRIES=2            # повторы SDK при 429/5xx/обрыве связи
# LLM_FIX_ATTEMPTS=1           # повторных генераций, если черновик не прошёл проверки
# LLM_FALLBACKS=default        # серверный fallback Anthropic при отказе модели; off чтобы выключить
